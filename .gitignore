*.py[cod]
*$py.class
*.so
.Python

# --- Linters, Type Checkers & Test Caches ---
.ruff_cache/
.mypy_cache/
.pytest_cache/
.cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
cover/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Large AI Models, Weights & Checkpoints (>50MB) ---
*.onnx
*.onnx.json
*.bin
*.pt
*.pth
*.safetensors
*.gguf
models/

# --- Generated Vector DB, Search Indices & Pickles ---
*.pkl
*.pickle
bm25_index.pkl
qdrant_data/
benchmark_data/
*.sqlite
*.sqlite3
*.db

# --- Generated Media, Audio & Screenshots ---
screenshots/
*.png
*.jpg
*.jpeg
*.gif
*.wav
*.mp3
*.ogg
*.flac
*.m4a
output.wav
test.mp3

# --- Logs & Runtime Output ---
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# --- Secrets, API Keys & Local Config Overrides ---
.env
.env.*
*.token
HF_TOKEN
credentials.json
config.local.json

# --- IDEs & Operating System Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Packaging & Distribution ---
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# --- Local Tests, Benchmarks & Scratch Scripts ---
tests/
test_*.py
benchmark_real.py
evaluate_rag.py
populate_qdrant.py
scratch/
*RAG_IMPLEMENTATION_PLAN.md